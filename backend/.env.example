# Copy this file to .env and fill in the real password you set when you
# created the csrp2_app user in pgAdmin. Never commit the real .env file.
DATABASE_URL=postgresql+psycopg2://csrp2_app:your-password-here@localhost:5432/qc_road_safety

# Browser origins allowed to call this API (comma-separated, no trailing slash).
# Add the address of your deployed frontend here, e.g. https://my-app.vercel.app
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Set to true when the site is served over HTTPS, so the sign-in cookie is never sent
# over plain HTTP. Leave false for local development (http://localhost).
COOKIE_SECURE=false
